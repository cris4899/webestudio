<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BLoginViews_Estudio.EntryContraseniaV5">
    <ContentView.Resources>
        <x:Double x:Key="EspaciadoAndroid">10</x:Double>
        <x:Double x:Key="EspaciadoWindows">20</x:Double>
    </ContentView.Resources>
    <!-- El recurso dinámico se enlaza en el código subyacente: On.Value no es una propiedad enlazable -->
    <StackLayout x:Name="pila" Orientation="Horizontal">
        <Label Text="Contraseña"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry x:Name="eContrasenia" 
               MaxLength="10"
               Keyboard="Default"
               IsPassword="True"
               Unfocused="ContraseniaPierdeFoco"/>
        <Label x:Name="lContrasenia"
            Text=""
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </StackLayout>
</ContentView>
