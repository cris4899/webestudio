<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:codigo="clr-namespace:BLoginViews_Estudio"
             x:Class="BLoginViews_Estudio.EntryContraseniaV2">
    <StackLayout Orientation="Horizontal"
                 Spacing="{codigo:Espaciado}"> <!-- Establecimiento de la Extensión-->
        <Label Text="Contraseña"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry x:Name="eContrasenia" 
               MaxLength="10"
               Keyboard="Default"
               IsPassword="True"
               Unfocused="ContraseniaPierdeFoco"/>
        <Label x:Name="lContrasenia"
            Text=""
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </StackLayout>
</ContentView>
