<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- ejemplo:lr-app -->
            <Color x:Key="colorAplicacion">#512BD4</Color>
            <x:Double x:Key="tamanoTitulo">22</x:Double>
            <Style x:Key="estiloAviso" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource colorAplicacion}" />
                <Setter Property="FontSize" Value="{StaticResource tamanoTitulo}" />
            </Style>
            <!-- fin:lr-app -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
