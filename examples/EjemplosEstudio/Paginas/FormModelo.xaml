<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.FormModelo"
             Title="Modelo Usuario">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Entry x:Name="entradaNombre" Placeholder="Nombre" />
        <Button Text="Crear usuario" Clicked="CrearClick" />
        <Label x:Name="etiquetaResultado" />
    </VerticalStackLayout>
</ContentPage>
