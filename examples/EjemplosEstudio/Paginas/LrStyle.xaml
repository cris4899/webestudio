<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.LrStyle"
             Title="Style con recursos">
    <ContentPage.Resources>
        <Color x:Key="fgColor">DarkSlateBlue</Color>
        <x:Double x:Key="tamanoTexto">18</x:Double>
        <!-- ejemplo:lr-style -->
        <Style x:Key="infoLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource fgColor}" />
            <Setter Property="FontSize" Value="{StaticResource tamanoTexto}" />
            <Setter Property="FontAttributes" Value="Italic" />
        </Style>
        <!-- fin:lr-style -->
    </ContentPage.Resources>
    <VerticalStackLayout Padding="20" Spacing="8">
        <Label Text="Propina sugerida" Style="{StaticResource infoLabelStyle}" />
        <Label Text="Total a pagar" Style="{StaticResource infoLabelStyle}" />
    </VerticalStackLayout>
</ContentPage>
