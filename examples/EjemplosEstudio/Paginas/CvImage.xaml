<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.CvImage"
             Title="Image y Aspect">
    <VerticalStackLayout Padding="20" Spacing="10">
        <!-- ejemplo:cv-image -->
        <Image x:Name="imagen" Source="figura" Aspect="AspectFit" WidthRequest="200" HeightRequest="200" BackgroundColor="LightGray" />
        <HorizontalStackLayout Spacing="6">
            <Button Text="AspectFit" Clicked="AjusteClick" />
            <Button Text="AspectFill" Clicked="AjusteClick" />
            <Button Text="Fill" Clicked="AjusteClick" />
        </HorizontalStackLayout>
        <!-- fin:cv-image -->
    </VerticalStackLayout>
</ContentPage>
