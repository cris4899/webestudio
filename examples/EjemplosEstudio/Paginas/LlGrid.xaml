<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.LlGrid"
             Title="Disposición con Grid">
    <!-- ejemplo:ll-grid -->
    <Grid Padding="20" ColumnSpacing="10" RowSpacing="8"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
          ColumnDefinitions="*,*">
        <Label Text="Cuenta:" Grid.Row="0" Grid.Column="0" />
        <Entry Placeholder="0,00" Grid.Row="0" Grid.Column="1" />
        <Label Text="Propina:" Grid.Row="1" Grid.Column="0" />
        <Label Text="0,00" Grid.Row="1" Grid.Column="1" />
        <Label Text="Total:" Grid.Row="2" Grid.Column="0" />
        <Label Text="0,00" Grid.Row="2" Grid.Column="1" />
        <Slider Minimum="0" Maximum="30" Value="15" Grid.Row="3" Grid.ColumnSpan="2" VerticalOptions="Center" />
        <Button Text="15%" Grid.Row="4" Grid.Column="0" />
        <Button Text="20%" Grid.Row="4" Grid.Column="1" />
        <Button Text="Redondear abajo" Grid.Row="5" Grid.Column="0" />
        <Button Text="Redondear arriba" Grid.Row="5" Grid.Column="1" />
        <Label Text="Los índices empiezan en cero." Grid.Row="6" Grid.ColumnSpan="2" />
    </Grid>
    <!-- fin:ll-grid -->
</ContentPage>
