<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.MatAviso"
             Title="Aviso de error">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Entry x:Name="entradaMatricula" Placeholder="0000-BBB" TextChanged="TextoCambiado" />
        <Label x:Name="etiquetaInfo" Padding="6" BackgroundColor="Transparent" />
    </VerticalStackLayout>
</ContentPage>
