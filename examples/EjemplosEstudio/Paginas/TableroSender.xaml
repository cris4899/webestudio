<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.TableroSender"
             Title="Tablero con mensaje">
    <VerticalStackLayout Padding="10" Spacing="8">
        <Grid x:Name="tablero" ColumnSpacing="4" RowSpacing="4" HeightRequest="300" />
        <Label x:Name="etiquetaMensaje" Text="Pulsa un botón del tablero." />
    </VerticalStackLayout>
</ContentPage>
