<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.MatPropiedad"
             Title="Propiedad Matricula">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Entry x:Name="entradaMatricula" />
        <Button Text="Asignar 1234-BCD" Clicked="AsignarBuenaClick" />
        <Button Text="Asignar 12-A" Clicked="AsignarMalaClick" />
        <Label x:Name="etiquetaResultado" />
    </VerticalStackLayout>
</ContentPage>
