<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.RecVerificar"
             Title="Static frente a Dynamic">
    <ContentPage.Resources>
        <Color x:Key="colorTexto">Black</Color>
    </ContentPage.Resources>
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Con StaticResource" TextColor="{StaticResource colorTexto}" />
        <Label Text="Con DynamicResource" TextColor="{DynamicResource colorTexto}" />
        <Button Text="Cambiar colorTexto a rojo" Clicked="CambiarClick" />
    </VerticalStackLayout>
</ContentPage>
