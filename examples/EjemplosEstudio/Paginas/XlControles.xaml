<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.XlControles"
             Title="Label, Entry y Button">
    <VerticalStackLayout Padding="20" Spacing="8">
        <!-- ejemplo:xl-controles -->
        <Label x:Name="etiquetaSaludo" Text="Escribe tu nombre" FontSize="18" TextColor="DarkSlateBlue" HorizontalTextAlignment="Center" />
        <Entry x:Name="entradaNombre" Placeholder="Nombre" />
        <Entry x:Name="entradaClave" Placeholder="Contraseña" IsPassword="True" />
        <Button Text="Saludar" Clicked="SaludarClick" />
        <!-- fin:xl-controles -->
    </VerticalStackLayout>
</ContentPage>
