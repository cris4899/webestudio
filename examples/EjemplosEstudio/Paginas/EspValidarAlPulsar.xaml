<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.EspValidarAlPulsar"
             Title="Validar al pulsar">
    <VerticalStackLayout Padding="20" Spacing="8">
        <local:EntryNombreUsuario x:Name="entradaUsuario" Unfocused="UsuarioSinFoco" />
        <Button Text="Entrar" Clicked="EntrarClick" />
        <Label x:Name="etiquetaError" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
