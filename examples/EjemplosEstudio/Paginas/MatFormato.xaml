<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.MatFormato"
             Title="Formato de matrícula">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Entry x:Name="entradaMatricula" Placeholder="0000-BBB" />
        <Button Text="Comprobar" Clicked="ComprobarClick" />
        <Label x:Name="etiquetaResultado" />
    </VerticalStackLayout>
</ContentPage>
