<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.LxXaml"
             Title="Notes en XAML">
    <!-- ejemplo:lx-xaml -->
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Notas" FontSize="22" />
        <Editor x:Name="editor" Placeholder="Escribe una nota" HeightRequest="140" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Guardar" Grid.Column="0" />
            <Button Text="Borrar" Grid.Column="1" />
        </Grid>
    </VerticalStackLayout>
    <!-- fin:lx-xaml -->
</ContentPage>
