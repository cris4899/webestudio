<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.XlBoxSlider"
             Title="BoxView y Slider">
    <VerticalStackLayout Padding="20" Spacing="12">
        <BoxView x:Name="rectangulo" Color="SteelBlue" HeightRequest="40" WidthRequest="100" HorizontalOptions="Start" />
        <Slider x:Name="deslizador" Minimum="50" Maximum="300" Value="100" ValueChanged="ValorCambiado" />
        <Label x:Name="etiquetaValor" Text="Ancho: 100" />
    </VerticalStackLayout>
</ContentPage>
