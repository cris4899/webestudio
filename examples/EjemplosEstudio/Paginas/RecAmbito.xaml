<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.RecAmbito"
             Title="Recursos locales">
    <VerticalStackLayout Padding="20">
        <!-- ejemplo:rec-ambito -->
        <ContentView>
            <ContentView.Resources>
                <ResourceDictionary>
                    <Color x:Key="colorEtiqueta">DarkGreen</Color>
                    <Color x:Key="colorEntrada">DarkRed</Color>
                    <x:Double x:Key="tamanoEtiqueta">20</x:Double>
                </ResourceDictionary>
            </ContentView.Resources>
            <VerticalStackLayout Spacing="8">
                <Label Text="Etiqueta con recursos del ContentView"
                       TextColor="{StaticResource colorEtiqueta}"
                       FontSize="{StaticResource tamanoEtiqueta}" />
                <Entry Text="Entrada con otra clave" TextColor="{StaticResource colorEntrada}" />
            </VerticalStackLayout>
        </ContentView>
        <!-- fin:rec-ambito -->
    </VerticalStackLayout>
</ContentPage>
