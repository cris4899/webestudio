<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.LrComparar"
             Title="Comparar mecanismos">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="StaticResource: no cambia" TextColor="{StaticResource colorAplicacion}" />
        <Label Text="DynamicResource: cambia" TextColor="{DynamicResource colorAplicacion}" />
        <Label Text="Style con StaticResource dentro" Style="{StaticResource estiloAviso}" />
        <Button Text="Alternar colorAplicacion" Clicked="AlternarClick" />
    </VerticalStackLayout>
</ContentPage>
