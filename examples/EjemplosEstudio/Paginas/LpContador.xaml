<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Estudio"
             x:Class="Estudio.LpContador"
             Title="Contador">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label x:Name="etiquetaCuenta" Text="Aún sin pulsar" />
        <Button x:Name="botonContar" Text="Pulsar" Clicked="ContarClick" />
    </VerticalStackLayout>
</ContentPage>
